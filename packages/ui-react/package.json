{
  "name": "popola-ui-react",
  "version": "0.1.0",
  "license": "MIT",
  "description": "React rendering of the popola UI layer.",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "module": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/cjs/index.js"
    },
    "./shell": {
      "types": "./dist/esm/shell/index.d.ts",
      "module": "./dist/esm/shell/index.js",
      "require": "./dist/cjs/shell/index.js",
      "default": "./dist/cjs/shell/index.js"
    },
    "./conversation": {
      "types": "./dist/esm/conversation/index.d.ts",
      "module": "./dist/esm/conversation/index.js",
      "require": "./dist/cjs/conversation/index.js",
      "default": "./dist/cjs/conversation/index.js"
    },
    "./composer": {
      "types": "./dist/esm/composer/index.d.ts",
      "module": "./dist/esm/composer/index.js",
      "require": "./dist/cjs/composer/index.js",
      "default": "./dist/cjs/composer/index.js"
    },
    "./permission": {
      "types": "./dist/esm/permission/index.d.ts",
      "module": "./dist/esm/permission/index.js",
      "require": "./dist/cjs/permission/index.js",
      "default": "./dist/cjs/permission/index.js"
    },
    "./markdown": {
      "types": "./dist/esm/markdown/index.d.ts",
      "module": "./dist/esm/markdown/index.js",
      "require": "./dist/cjs/markdown/index.js",
      "default": "./dist/cjs/markdown/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -b && tsc -p tsconfig.cjs.json",
    "typecheck": "tsc -p stories",
    "dev": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "clean": "rm -rf dist tsconfig.tsbuildinfo storybook-static"
  },
  "dependencies": {
    "licia": "^1.49.0",
    "markdown-it": "^14.3.3",
    "popola-ui": "^0.1.0"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2"
  }
}
