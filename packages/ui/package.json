{
  "name": "popola-ui",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Framework-agnostic core of the popola UI layer: state, slots, tokens, class contract.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./style.css": "./src/style.css"
  },
  "files": [
    "dist",
    "src/**/*.css"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "popola-protocol": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "22.18.13",
    "typescript": "7.0.2"
  }
}
