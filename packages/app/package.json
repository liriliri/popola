{
  "name": "popola-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Electron app for trying the popola UI against a pi coding agent.",
  "main": "./dist/main/index.js",
  "scripts": {
    "dev": "vite build --config vite.main.ts && vite",
    "start": "wait-on http://127.0.0.1:5173 && POPOLA_DEV=1 electron .",
    "build": "tsc -b && vite build --config vite.main.ts && vite build",
    "typecheck": "tsc -b && tsc -p tsconfig.renderer.json",
    "clean": "rm -rf dist tsconfig.tsbuildinfo .data"
  },
  "dependencies": {
    "i18next": "^27.2.6",
    "licia": "^1.49.0",
    "lucide-react": "^1.79.0",
    "mobx": "^7.1.7",
    "mobx-react-lite": "^5.1.4",
    "popola-pi": "^0.1.0",
    "popola-protocol": "^0.1.0",
    "popola-ui": "^0.1.0",
    "popola-ui-react": "^0.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^18.0.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^39.2.2",
    "typescript": "7.0.2",
    "vite": "^8.3.8",
    "wait-on": "^8.0.5"
  }
}
